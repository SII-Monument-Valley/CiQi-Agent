# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=""
QDRANT_COLLECTION=multimodal_zh

# Generated data; PROJECT_ROOT is exported by the start script
DATA_DIR=${PROJECT_ROOT}/artifacts/rag
CLIP_VEC=${DATA_DIR}/clip_vectors.npy
CLIP_META=${DATA_DIR}/clip_meta.jsonl
TEXT_VEC=${DATA_DIR}/text_vectors.npy
TEXT_META=${DATA_DIR}/text_meta.jsonl

# Hugging Face IDs or local model directories
CLIP_MODEL_NAME=OFA-Sys/chinese-clip-vit-large-patch14
TEXT_MODEL_NAME=BAAI/bge-m3

CLIP_DISTANCE=COSINE
TEXT_DISTANCE=COSINE
UVICORN_PORT=8000
UVICORN_WORKERS=1
DEFAULT_TOPK=10
CUDA_VISIBLE_DEVICES=0
